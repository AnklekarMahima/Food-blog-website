<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Edit Post</title>
</head>
<body>
    <header>
        <h1>Edit <%= post.title %></h1>
        <nav>
            <a href="/">Home</a>
            <a href="/create">Create New Post</a>
        </nav>
    </header>

    <main>
        <form action="/edit/<%= post.id %>" method="POST" enctype="multipart/form-data">
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= post.title %>" required>
            <p id="title-char-count" style="margin-top: 0;"><%= post.title.length %>/25 characters</p>

            <label for="description">Short Description:</label>
            <textarea id="description" name="description" placeholder="Describe your food post" maxlength="110" required><%= post.description %></textarea>
            <p id="description-char-count" style="margin-top: 0;"><%= post.description.length%>/110 characters</p>

            <label for="content">Content:</label>
            <textarea id="content" name="content" required><%= post.content %></textarea>

            <label for="image">Change Image (optional):</label>
            <input type="file" id="image" name="image" accept="image/*">

            <button type="submit">Update Post</button>
        </form>
        <script>
            const titleInput = document.getElementById('title');
            const titleCharCount = document.getElementById('title-char-count');
            const maxTitleLength = 25;
        
            const descriptionTextarea = document.getElementById('description');
            const descriptionCharCount = document.getElementById('description-char-count');
            const maxDescriptionLength = 110;
        
            // Initialize character counts
            titleCharCount.textContent = `${titleInput.value.length}/${maxTitleLength} characters`;
            descriptionCharCount.textContent = `${descriptionTextarea.value.length}/${maxDescriptionLength} characters`;
        
            // Update title character count dynamically
            titleInput.addEventListener('input', function () {
                const currentLength = titleInput.value.length;
                titleCharCount.textContent = `${currentLength}/${maxTitleLength} characters`;
        
                if (currentLength > maxTitleLength) {
                    titleInput.value = titleInput.value.substring(0, maxTitleLength);
                }
            });
        
            // Update description character count dynamically
            descriptionTextarea.addEventListener('input', function () {
                const currentLength = descriptionTextarea.value.length;
                descriptionCharCount.textContent = `${currentLength}/${maxDescriptionLength} characters`;
        
                if (currentLength > maxDescriptionLength) {
                    descriptionTextarea.value = descriptionTextarea.value.substring(0, maxDescriptionLength);
                }
            });
        </script>
    </main>

    <footer>
        <p>&copy; 2024 Foodie's Haven | All rights reserved.</p>
    </footer>
</body>
</html>





